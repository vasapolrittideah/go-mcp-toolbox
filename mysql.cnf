# The mysql image defaults client programs to latin1 (verified on 9.7), which
# double-encodes the UTF-8 Thai text in the init scripts. Force utf8mb4 on both
# ends. Removing this silently corrupts the seed data.
[mysqld]
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4
